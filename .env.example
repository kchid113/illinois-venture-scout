# Vercel project: Production and Preview MUST use different Supabase projects.
# Supabase project Settings -> API: public project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only Supabase Postgres transaction-pooler URL; never use NEXT_PUBLIC_.
# Use the connection URI from Supabase's Connect -> Transaction pooler panel.
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:6543/postgres

# Restrict Vercel Cron; generate a random 32+ character secret, never commit it.
CRON_SECRET=replace-with-a-random-32-character-minimum-secret
