# Supabase PostgreSQL server-only transaction pooler URL. Required for public pages.
# Vercel Preview and Production MUST use different Supabase projects.
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:6543/postgres

# Secret bearer token for 12 Vercel scheduled ingestion jobs. Required for cron.
CRON_SECRET=replace-with-a-random-32-character-minimum-secret

# Optional: used only by separately protected legacy/admin Supabase Auth helpers.
# Visitor browsing and browser-local research do not require Supabase Auth keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
