# On Sites, configure these using runtime environment variables.
# Locally use ignored .dev.vars (Wrangler) rather than committing values.
ADMIN_EMAIL=
ADMIN_TOKEN=
# DB is a D1 binding provided by the hosting manifest, not a URL.
# Optional AI is not implemented; no OpenAI key is required.


# Patch 4 — GitHub Student Developer Pack. ALL OPTIONAL, OFF BY DEFAULT.
# Local overrides belong in ignored .env/.dev.vars; production secrets go
# into GitHub Actions Secrets or the supported host secret store.
IVR_SIMPLE_ANALYTICS_ENABLED=false
# Only used by the scheduled GitHub Actions job, not by the end-user browser.
IVR_HONEYBADGER_CHECKIN_URL=
IVR_BROWSERSTACK_ENABLED=false
IVR_BROWSERSTACK_SITE_URL=
IVR_BROWSERSTACK_DEVICE=Samsung Galaxy S20
IVR_BROWSERSTACK_OS_VERSION=10.0
IVR_BROWSERSTACK_USERNAME=
IVR_BROWSERSTACK_ACCESS_KEY=
IVR_CODECOV_ENABLED=false
CODECOV_TOKEN=
